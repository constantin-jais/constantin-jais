{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constantin-jais.github.io/ecosystem/schemas/wrench-evidence-report.v0.1.schema.json",
  "title": "Wrench EvidenceReport v0.1",
  "type": "object",
  "required": [
    "format",
    "report_id",
    "generated_at",
    "producer",
    "subject",
    "status",
    "summary",
    "findings",
    "checks",
    "evidence_refs",
    "source_report",
    "next_actions"
  ],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "wrench.evidence_report.v0.1" },
    "report_id": { "type": "string", "pattern": "^wrench-[a-z0-9-]+-[a-f0-9]{16}$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "producer": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 3 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "subject": {
      "type": "object",
      "required": ["kind", "reference"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "enum": ["portal_ui", "handoff", "gear_loader_output", "spec_package", "browser_surface"] },
        "reference": { "type": "string", "minLength": 1 }
      }
    },
    "status": { "type": "string", "enum": ["passed", "warning", "failed"] },
    "summary": { "$ref": "#/$defs/summary" },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/check" }
    },
    "evidence_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence_ref" }
    },
    "source_report": {
      "type": "object",
      "required": ["format", "hash", "body"],
      "additionalProperties": false,
      "properties": {
        "format": { "type": "string", "minLength": 3 },
        "hash": { "$ref": "#/$defs/sha256" },
        "body": { "type": "object" }
      }
    },
    "next_actions": {
      "type": "array",
      "items": { "type": "string", "minLength": 3 }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[A-Fa-f0-9]{64}$"
    },
    "summary": {
      "type": "object",
      "required": ["errors", "warnings", "infos"],
      "additionalProperties": false,
      "properties": {
        "errors": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "infos": { "type": "integer", "minimum": 0 }
      }
    },
    "finding": {
      "type": "object",
      "required": ["severity", "code", "path", "message", "recommendation"],
      "additionalProperties": false,
      "properties": {
        "severity": { "type": "string", "enum": ["error", "warning", "info"] },
        "code": { "type": "string", "minLength": 3 },
        "path": { "type": "string" },
        "message": { "type": "string", "minLength": 3 },
        "recommendation": { "type": "string", "minLength": 3 }
      }
    },
    "check": {
      "type": "object",
      "required": ["code", "status", "summary"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "minLength": 3 },
        "status": { "type": "string", "enum": ["passed", "warning", "failed"] },
        "summary": { "type": "string", "minLength": 3 }
      }
    },
    "evidence_ref": {
      "type": "object",
      "required": ["kind", "reference", "hash", "status", "summary"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "minLength": 3 },
        "reference": { "type": "string", "minLength": 1 },
        "hash": { "$ref": "#/$defs/sha256" },
        "status": { "type": "string", "minLength": 3 },
        "summary": { "type": "string", "minLength": 3 }
      }
    }
  }
}
