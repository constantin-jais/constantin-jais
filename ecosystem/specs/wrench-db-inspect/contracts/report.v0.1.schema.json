{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constantin.local/wrench-db-inspect/report.v0.1.schema.json",
  "title": "Wrench DB Inspect Report v0.1",
  "type": "object",
  "required": ["data", "meta"],
  "additionalProperties": false,
  "properties": {
    "data": {
      "type": "object",
      "required": ["format", "status", "summary", "findings"],
      "additionalProperties": true,
      "properties": {
        "format": { "const": "wrench.db_inspect.report.v0.1" },
        "status": { "enum": ["passed", "failed", "passed_with_waiver"] },
        "summary": {
          "type": "object",
          "required": ["gate_blocked"],
          "additionalProperties": true,
          "properties": {
            "critical": { "type": "integer", "minimum": 0 },
            "high": { "type": "integer", "minimum": 0 },
            "medium": { "type": "integer", "minimum": 0 },
            "low": { "type": "integer", "minimum": 0 },
            "info": { "type": "integer", "minimum": 0 },
            "gate_blocked": { "type": "boolean" }
          }
        },
        "scope": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "inspected_at": { "type": "string", "format": "date-time" }
          }
        },
        "metrics": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "parser_error_count": { "type": "integer", "minimum": 0 }
          }
        },
        "report_gate": { "type": "object" },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["rule_id", "category", "severity", "confidence", "subject"],
            "additionalProperties": true,
            "properties": {
              "rule_id": { "type": "string", "minLength": 1 },
              "category": { "type": "string", "minLength": 1 },
              "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
              "confidence": { "enum": ["high", "medium", "low"] },
              "subject": {
                "type": "object",
                "required": ["type", "name"],
                "additionalProperties": true,
                "properties": {
                  "type": { "type": "string", "minLength": 1 },
                  "name": { "type": "string", "minLength": 1 }
                }
              },
              "gate": { "type": "object" },
              "waiver": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "expires_at": { "type": ["string", "null"], "format": "date-time" },
                  "expiry_valid": { "type": "boolean" },
                  "expired": { "type": "boolean" }
                }
              }
            }
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "required": ["schema_version", "redaction"],
      "additionalProperties": true,
      "properties": {
        "schema_version": { "const": "0.1" },
        "redaction": {
          "type": "object",
          "required": ["secrets_or_pii_included"],
          "additionalProperties": true,
          "properties": {
            "secrets_or_pii_included": { "const": false },
            "applied": { "type": "boolean" }
          }
        }
      }
    }
  }
}
