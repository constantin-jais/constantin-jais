{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constantin.local/wrench-db-inspect/manifest.v0.1.schema.json",
  "title": "Wrench DB Inspect Manifest v0.1",
  "type": "object",
  "required": ["data", "meta"],
  "additionalProperties": false,
  "properties": {
    "data": {
      "type": "object",
      "required": ["format", "product", "tenant", "roles", "tables", "waivers"],
      "additionalProperties": false,
      "properties": {
        "format": { "const": "wrench.db_inspect.manifest.v0.1" },
        "product": { "type": "string", "minLength": 1 },
        "tenant": {
          "type": "object",
          "required": ["canonical_name", "column"],
          "additionalProperties": false,
          "properties": {
            "canonical_name": { "type": "string", "minLength": 1 },
            "product_alias": { "type": "string" },
            "column": { "type": "string", "minLength": 1 }
          }
        },
        "roles": {
          "type": "object",
          "required": ["app", "readonly", "migration"],
          "additionalProperties": false,
          "properties": {
            "app": { "$ref": "#/$defs/stringArray" },
            "readonly": { "$ref": "#/$defs/stringArray" },
            "migration": { "$ref": "#/$defs/stringArray" }
          }
        },
        "tables": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "classification", "contains_personal_data", "contains_embeddings"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "classification": { "enum": ["tenant_scoped", "public_reference", "internal", "audit", "audit_system", "unknown"] },
              "tenant_column": { "type": ["string", "null"] },
              "tenant_derivation": { "type": ["string", "null"] },
              "contains_personal_data": { "type": "boolean" },
              "contains_embeddings": { "type": "boolean" }
            }
          }
        },
        "waivers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "rule_id", "subject_type", "subject_name", "reason"],
            "additionalProperties": true,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "rule_id": { "type": "string", "minLength": 1 },
              "subject_type": { "type": "string", "minLength": 1 },
              "subject_name": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 },
              "expires_at": { "type": ["string", "null"] },
              "owner_actor_ref": { "type": ["string", "null"] },
              "reviewer_actor_ref": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "required": ["schema_version"],
      "additionalProperties": true,
      "properties": {
        "schema_version": { "const": "0.1" }
      }
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
