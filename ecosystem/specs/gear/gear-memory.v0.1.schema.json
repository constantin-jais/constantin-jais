{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constantin-jais.github.io/specs/gear-memory.v0.1.schema.json",
  "title": "Gear Memory v0.1 Contracts",
  "type": "object",
  "required": ["format"],
  "properties": {
    "format": { "const": "gear.memory.v0.1" },
    "source_refs": { "type": "array", "items": { "$ref": "#/$defs/source_ref" } },
    "memory_entries": { "type": "array", "items": { "$ref": "#/$defs/memory_entry" } },
    "event_log_entries": { "type": "array", "items": { "$ref": "#/$defs/event_log_entry" } },
    "code_maps": { "type": "array", "items": { "$ref": "#/$defs/code_map" } },
    "provenance_records": { "type": "array", "items": { "$ref": "#/$defs/provenance_record" } }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^sha256:[A-Fa-f0-9]{64}$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$" },
    "safe_metadata": {
      "type": "object",
      "propertyNames": {
        "not": { "pattern": "(?i)^(secret|token|password|credential|api[_-]?key|raw[_-]?log|.*[_-](secret|token|password|credential|api[_-]?key|raw[_-]?log)([_-]?(value|text|raw|body))?)$" }
      },
      "additionalProperties": {
        "type": ["string", "number", "boolean", "null", "array", "object"]
      }
    },
    "source_ref": {
      "type": "object",
      "required": ["source_id", "source_type", "origin_product", "content_hash", "provenance_id", "state", "created_at"],
      "properties": {
        "source_id": { "$ref": "#/$defs/id" },
        "source_type": { "enum": ["file", "url", "feed_item", "note_block", "transcript", "document", "dataset", "artifact"] },
        "origin_product": { "$ref": "#/$defs/id" },
        "uri": { "type": ["string", "null"] },
        "content_hash": { "$ref": "#/$defs/sha256" },
        "provenance_id": { "$ref": "#/$defs/id" },
        "state": { "enum": ["active", "stale", "deleted", "anonymized", "revoked"] },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "metadata": { "$ref": "#/$defs/safe_metadata" }
      },
      "additionalProperties": false
    },
    "memory_entry": {
      "type": "object",
      "required": ["memory_entry_id", "source_ref", "content_hash", "index_state", "index_metadata", "created_at"],
      "properties": {
        "memory_entry_id": { "$ref": "#/$defs/id" },
        "source_ref": { "$ref": "#/$defs/id" },
        "content_hash": { "$ref": "#/$defs/sha256" },
        "index_state": { "enum": ["pending", "indexed", "stale", "deleted", "anonymized", "revoked"] },
        "index_metadata": {
          "type": "object",
          "required": ["schema_version", "chunk_count"],
          "properties": {
            "schema_version": { "const": "memory-entry.v0.1" },
            "chunk_count": { "type": "integer", "minimum": 0 },
            "embedding_model_ref": { "type": ["string", "null"] },
            "indexed_at": { "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] }
          },
          "additionalProperties": false
        },
        "created_at": { "$ref": "#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "event_log_entry": {
      "type": "object",
      "required": ["event_id", "event_type", "actor_ref", "target_ref", "provenance_id", "metadata", "created_at"],
      "properties": {
        "event_id": { "$ref": "#/$defs/id" },
        "event_type": { "$ref": "#/$defs/id" },
        "actor_ref": { "$ref": "#/$defs/id" },
        "target_ref": { "$ref": "#/$defs/id" },
        "provenance_id": { "$ref": "#/$defs/id" },
        "metadata": { "$ref": "#/$defs/safe_metadata" },
        "created_at": { "$ref": "#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "provenance_record": {
      "type": "object",
      "required": ["provenance_id", "actor_ref", "operation", "inputs", "outputs", "timestamp", "metadata"],
      "properties": {
        "provenance_id": { "$ref": "#/$defs/id" },
        "actor_ref": { "$ref": "#/$defs/id" },
        "operation": { "enum": ["created", "imported", "transformed", "indexed", "linked", "stale_marked", "exported", "signed", "distributed", "revoked", "deleted", "anonymized"] },
        "inputs": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "outputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
        "tool_ref": { "type": ["string", "null"] },
        "timestamp": { "$ref": "#/$defs/timestamp" },
        "metadata": { "$ref": "#/$defs/safe_metadata" }
      },
      "additionalProperties": false
    },
    "code_map": {
      "type": "object",
      "required": ["code_map_id", "root_source_ref", "scope", "parser_refs", "symbols", "edges", "state", "created_at"],
      "properties": {
        "code_map_id": { "$ref": "#/$defs/id" },
        "root_source_ref": { "$ref": "#/$defs/id" },
        "scope": {
          "type": "object",
          "required": ["revision", "paths"],
          "properties": {
            "repo_ref": { "type": ["string", "null"] },
            "revision": { "$ref": "#/$defs/id" },
            "paths": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          },
          "additionalProperties": false
        },
        "parser_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "symbols": { "type": "array", "items": { "$ref": "#/$defs/code_symbol" } },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/code_edge" } },
        "state": { "enum": ["active", "stale", "deleted"] },
        "created_at": { "$ref": "#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "code_symbol": {
      "type": "object",
      "required": ["symbol_id", "kind", "name", "source_ref", "range", "content_hash"],
      "properties": {
        "symbol_id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["function", "type", "module", "trait", "interface", "route", "table", "test", "config", "file"] },
        "name": { "$ref": "#/$defs/id" },
        "source_ref": { "$ref": "#/$defs/id" },
        "range": {
          "type": "object",
          "required": ["start_line", "end_line"],
          "properties": {
            "start_line": { "type": "integer", "minimum": 1 },
            "end_line": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "content_hash": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "code_edge": {
      "type": "object",
      "required": ["from", "to", "kind"],
      "properties": {
        "from": { "$ref": "#/$defs/id" },
        "to": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["defines", "calls", "imports", "tests", "configures", "documents", "generated_from", "belongs_to", "cites", "derived_from", "supersedes"] }
      },
      "additionalProperties": false
    }
  }
}
