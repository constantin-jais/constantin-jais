{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constantin-jais.github.io/ecosystem/schemas/gear-artifact-manifest.v0.1.schema.json",
  "title": "Gear ArtifactManifest v0.1",
  "type": "object",
  "required": [
    "manifest_id",
    "artifact",
    "package_type",
    "checksums",
    "provenance_id",
    "retention",
    "distribution",
    "metadata"
  ],
  "additionalProperties": false,
  "properties": {
    "manifest_id": { "type": "string", "minLength": 1 },
    "artifact": {
      "type": "object",
      "required": ["artifact_id", "artifact_type", "producer", "version", "hash", "manifest_ref", "state", "created_at"],
      "additionalProperties": false,
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "artifact_type": {
          "enum": ["spec_package", "handoff_payload", "curated_export", "learning_export", "release_asset", "inspection_report"]
        },
        "producer": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "hash": { "$ref": "#/$defs/sha256" },
        "manifest_ref": { "type": "string", "minLength": 1 },
        "state": { "enum": ["active", "revoked", "superseded", "deleted"] },
        "created_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "package_type": {
      "enum": ["json_bundle", "tar", "zip", "binary", "container", "registry_package"]
    },
    "checksums": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["algorithm", "value"],
        "additionalProperties": false,
        "properties": {
          "algorithm": { "const": "sha256" },
          "value": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "provenance_id": { "type": "string", "minLength": 1 },
    "retention": {
      "type": "object",
      "required": ["policy_ref", "expires_at", "revoked_at", "delete_after"],
      "additionalProperties": false,
      "properties": {
        "policy_ref": { "type": ["string", "null"] },
        "expires_at": { "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
        "revoked_at": { "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
        "delete_after": { "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] }
      }
    },
    "distribution": {
      "type": "object",
      "required": ["channels", "install_floor", "published_at"],
      "additionalProperties": false,
      "properties": {
        "channels": { "type": "array", "items": { "type": "string" } },
        "install_floor": { "type": ["string", "null"] },
        "published_at": { "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["values"],
      "additionalProperties": false,
      "properties": {
        "values": {
          "type": "object",
          "propertyNames": {
            "not": { "pattern": "(?i)(secret|token|password|credential|api[_-]?key)" }
          },
          "additionalProperties": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[A-Fa-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  }
}
