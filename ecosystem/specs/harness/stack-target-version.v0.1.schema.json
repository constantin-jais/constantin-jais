{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stack-target-version.v0.1.schema.json",
  "title": "Stack target version",
  "description": "Machine-readable ratified target of the ecosystem stack: layer model, elected shells, ownership decisions, stack matrix, and DoD chain. The human companion is ecosystem/target-version.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "ratified_at",
    "ratified_by",
    "layers",
    "web_shell",
    "design_system",
    "native_delivery",
    "desktop",
    "static_publication",
    "session_runtime_owner",
    "identity_ownership",
    "stack_matrix",
    "dod_chain",
    "flagship_slice",
    "wave"
  ],
  "properties": {
    "format": { "const": "stack.target_version.v0.1" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "ratified_at": { "type": "string" },
    "ratified_by": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "layers": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prefix", "role", "definition", "deployment_classes"],
        "properties": {
          "prefix": { "enum": ["rumble", "portal", "bolt", "wrench", "gear"] },
          "role": { "type": "string" },
          "definition": { "type": "string" },
          "deployment_classes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": ["product-linkable", "factory-only", "build-time"]
            }
          }
        }
      }
    },
    "web_shell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["framework", "framework_version", "evidence", "adr"],
      "properties": {
        "framework": { "type": "string" },
        "framework_version": { "type": "string" },
        "evidence": { "type": "string" },
        "adr": { "type": "string" }
      }
    },
    "component_library": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source", "styling", "adr"],
      "properties": {
        "name": { "type": "string" },
        "source": { "type": "string" },
        "styling": { "type": "string" },
        "license": { "type": "string" },
        "crates_io_follow_up": { "type": "string" },
        "adr": { "type": "string" },
        "first_application": { "type": "string" }
      }
    },
    "design_system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "source", "compiler", "palette", "typography", "distribution", "exceptions", "adr"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "source": { "type": "string" },
        "compiler": { "type": "string" },
        "palette": { "type": "string" },
        "typography": { "type": "string" },
        "distribution": { "type": "string" },
        "exceptions": { "type": "string" },
        "adr": { "type": "string" }
      }
    },
    "native_delivery": { "type": "string" },
    "desktop": { "type": "string" },
    "static_publication": { "type": "string" },
    "session_runtime_owner": { "type": "string" },
    "identity_ownership": { "type": "string" },
    "stack_matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["go", "conditional_go", "spike_local", "wait", "no_go"],
      "properties": {
        "go": { "type": "array", "items": { "type": "string" } },
        "conditional_go": { "type": "array", "items": { "type": "string" } },
        "spike_local": { "type": "array", "items": { "type": "string" } },
        "wait": { "type": "array", "items": { "type": "string" } },
        "no_go": { "type": "array", "items": { "type": "string" } },
        "narrowed": { "type": "array", "items": { "type": "string" } }
      }
    },
    "dod_chain": {
      "type": "array",
      "minItems": 8,
      "items": { "type": "string" }
    },
    "flagship_slice": { "type": "string" },
    "wave": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "posture", "reference"],
      "properties": {
        "name": { "type": "string" },
        "posture": { "type": "string" },
        "reference": { "type": "string" }
      }
    }
  }
}
