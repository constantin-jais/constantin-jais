{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constantin-jais.github.io/ecosystem/schemas/approval-key-registry.v0.1.schema.json",
  "title": "Bolt ApprovalKeyRegistry v0.1",
  "type": "object",
  "required": ["format", "registry_id", "issued_at", "keys"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "bolt.approval_key_registry.v0.1" },
    "registry_id": { "type": "string", "minLength": 1 },
    "issued_at": { "$ref": "#/$defs/timestamp" },
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/ApprovalKeyRef" }
    }
  },
  "$defs": {
    "ApprovalKeyRef": {
      "type": "object",
      "required": ["public_key_ref", "algorithm", "public_key", "state", "not_before", "expires_at"],
      "additionalProperties": false,
      "properties": {
        "public_key_ref": { "type": "string", "minLength": 1 },
        "algorithm": { "const": "ed25519" },
        "public_key": {
          "type": "string",
          "pattern": "^ed25519:[A-Fa-f0-9]{64}$"
        },
        "state": { "enum": ["active", "revoked"] },
        "not_before": { "$ref": "#/$defs/timestamp" },
        "expires_at": { "$ref": "#/$defs/timestamp" },
        "rotated_from": { "type": "string", "minLength": 1 },
        "rotated_to": { "type": "string", "minLength": 1 },
        "revoked_at": { "$ref": "#/$defs/timestamp" },
        "revocation_reason": { "type": "string", "minLength": 1 }
      }
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
