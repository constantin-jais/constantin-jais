{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constantin-jais.github.io/ecosystem/schemas/stack-project-maturity.v0.1.schema.json",
  "title": "Stack Project Maturity v0.1",
  "type": "object",
  "required": [
    "format",
    "project",
    "claimed_at",
    "current_increment",
    "scale_ready",
    "status_summary",
    "next_quality_step",
    "boundaries",
    "evidence",
    "verification_commands"
  ],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "stack.project_maturity.v0.1" },
    "project": {
      "type": "object",
      "required": ["name", "layer", "role", "maturity_mode"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^(portal|bolt|wrench|gear)-[a-z0-9-]+$" },
        "layer": { "type": "string", "enum": ["Portal", "Bolt", "Wrench", "Gear"] },
        "role": { "type": "string", "minLength": 8 },
        "maturity_mode": {
          "type": "string",
          "enum": ["speculative", "contract-first", "dojo", "usable", "trusted", "retired"]
        }
      }
    },
    "claimed_at": { "type": "string", "format": "date-time" },
    "current_increment": { "type": "string", "minLength": 3 },
    "scale_ready": { "type": "string", "enum": ["no", "partially", "yes, with evidence"] },
    "status_summary": { "type": "string", "minLength": 8 },
    "next_quality_step": { "type": "string", "minLength": 8 },
    "boundaries": {
      "type": "object",
      "required": ["owns", "does_not_own"],
      "additionalProperties": false,
      "properties": {
        "owns": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 4 } },
        "does_not_own": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 4 } }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "ref", "status"],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["doc", "adr", "schema", "fixture", "command", "workflow", "proof", "release_artifact"]
          },
          "ref": { "type": "string", "minLength": 3 },
          "status": { "type": "string", "enum": ["present", "passing", "warning", "blocked"] },
          "notes": { "type": "string", "minLength": 3 }
        }
      }
    },
    "verification_commands": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 3 }
    },
    "open_questions": {
      "type": "array",
      "items": { "type": "string", "minLength": 6 },
      "default": []
    },
    "risk_notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 6 },
      "default": []
    }
  }
}
