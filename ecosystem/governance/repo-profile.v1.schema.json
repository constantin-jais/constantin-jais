{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://libre-ia.fr/schemas/repo-profile.v1.json",
  "title": "Libre AI public repository profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "slug",
    "public_name_fr",
    "public_name_en",
    "domain",
    "maturity",
    "summary_en",
    "canonical_url",
    "visibility",
    "license_expression",
    "required_checks"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "public_name_fr": { "type": "string", "minLength": 1 },
    "public_name_en": { "type": "string", "minLength": 1 },
    "domain": {
      "enum": ["institutional", "product", "evidence", "distribution", "infrastructure"]
    },
    "maturity": {
      "enum": ["specification", "contract-first", "dojo", "usable", "recurring", "consolidated"]
    },
    "summary_en": { "type": "string", "minLength": 1, "maxLength": 350 },
    "canonical_url": {
      "type": "string",
      "pattern": "^https://github\\.com/libre-ai/[a-z0-9-]+$"
    },
    "visibility": { "const": "public" },
    "license_expression": { "type": "string", "minLength": 1 },
    "visual_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "historical_identifiers": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "required_checks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
