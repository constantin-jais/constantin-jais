{
  "version": 2,
  "ruleset_name": "ecosystem-standard",
  "defaults": {
    "target_branch": "main",
    "required_approving_review_count": 0,
    "dismiss_stale_reviews_on_push": true,
    "require_code_owner_review": false,
    "require_last_push_approval": false,
    "required_review_thread_resolution": true,
    "block_force_pushes": true,
    "block_deletions": true,
    "remove_classic_protection": true,
    "repo_settings": {
      "allow_auto_merge": true,
      "delete_branch_on_merge": true
    }
  },
  "repos": {
    "libre-ai/website": {
      "required_checks": ["quality", "e2e", "npm supply-chain gates", "Playwright product smoke"],
      "strict_up_to_date": true
    },
    "libre-ai/sessions": {
      "required_checks": ["Rust quality gates", "Repository guardrails", "Integration + coverage", "Rust supply-chain gates"],
      "strict_up_to_date": true
    },
    "libre-ai/feed-radar": {
      "required_checks": ["Rust quality gates", "Rust supply-chain gates", "License file presence", "CuratedItemExport contract", "Database inspection gate"],
      "strict_up_to_date": true
    },
    "libre-ai/spec-studio": {
      "required_checks": ["Rust quality gates", "Repository hygiene"],
      "strict_up_to_date": true
    },
    "libre-ai/agent-board": {
      "required_checks": ["Repository hygiene"],
      "strict_up_to_date": true
    },
    "libre-ai/notebook": {
      "required_checks": ["Repository hygiene"],
      "strict_up_to_date": true
    },
    "libre-ai/ai-practices": {
      "required_checks": ["Rust quality gates", "Repository hygiene", "Database inspection gate"],
      "strict_up_to_date": true
    },
    "libre-ai/benchmarks": {
      "required_checks": ["claude-fable-5", "codex-5-5"],
      "strict_up_to_date": true
    },
    "libre-ai/dioxus-app-template": {
      "required_checks": ["quality", "e2e", "Portal mirror parity"],
      "strict_up_to_date": true
    },
    "libre-ai/portal": {
      "required_checks": [
        "core Rust gates",
        "ui Rust gates",
        "forge Rust gates",
        "Canonical Dioxus template",
        "Canonical template browser gates",
        "Apple adapter over in-repository core",
        "Android adapter over in-repository core",
        "core supply chain",
        "ui supply chain",
        "forge supply chain",
        "template supply chain"
      ],
      "strict_up_to_date": true
    },
    "libre-ai/bolt": {
      "required_checks": ["Engine quality gates", "Engine supply chain", "Harness boundary and negative fixtures"],
      "strict_up_to_date": true
    },
    "libre-ai/wrench": {
      "required_checks": [
        "General inspection CLI",
        "Database inspection CLI",
        "Dioxus evidence lab",
        "inspect supply chain",
        "database supply chain",
        "dioxus-lab supply chain",
        "Dioxus desktop compile (linux)",
        "Dioxus desktop compile (macos)",
        "Dioxus desktop compile (windows)"
      ],
      "strict_up_to_date": true
    },
    "libre-ai/gear": {
      "required_checks": ["Context workspace", "Supply workspace", "Context supply chain", "Supply supply chain", "Context / Supply isolation"],
      "strict_up_to_date": true
    },
    "constantin-jais/constantin-jais": {
      "ruleset_name": "forge-standard",
      "required_checks": ["Stack workflow conventions", "json-schema-fixtures"],
      "strict_up_to_date": true
    }
  }
}
